# Set these in the process environment. This file is not auto-loaded.
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_SANDBOX_ID=existing-sandbox-id
# Optional semantic ranking; deterministic fallback without a key.
# One key, two independent consumers.
NOSANA_API_KEY=
# Daily path (/api/demo/schedule) re-ranking.
# NOSANA_BASE_URL=https://inference.nosana.com/v1
# NOSANA_MODEL=available-model-id
# Weekly path (/api/recommendations) plan ordering. Separate names so the two
# can point at different nodes/models. Set WEEKLY_LLM_PROVIDER to anything
# other than 'nosana' (e.g. 'off') to disable the weekly layer outright.
# WEEKLY_LLM_PROVIDER=nosana
# WEEKLY_LLM_BASE_URL=https://inference.nosana.com/v1
# WEEKLY_LLM_MODEL=qwen/qwen3.8-27b
# Optional exact HTTPS origin when exposing web_demo.py through Cloudflare Tunnel.
# HARNESS_PUBLIC_ORIGIN=https://timetable.shinick.dev
